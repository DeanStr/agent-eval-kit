{
  "contract": "total(items) returns the sum of integer unitPriceCents multiplied by quantity, with zero for an empty cart.",
  "examples": [
    {
      "items": [],
      "expected": 0
    },
    {
      "items": [
        {
          "unitPriceCents": 199,
          "quantity": 3
        }
      ],
      "expected": 597
    },
    {
      "items": [
        {
          "unitPriceCents": 199,
          "quantity": 3
        },
        {
          "unitPriceCents": 50,
          "quantity": 2
        }
      ],
      "expected": 697
    },
    {
      "items": [
        {
          "unitPriceCents": 199,
          "quantity": 0
        }
      ],
      "expected": 0
    },
    {
      "items": [
        {
          "unitPriceCents": 0,
          "quantity": 4
        },
        {
          "unitPriceCents": 125,
          "quantity": 2
        }
      ],
      "expected": 250
    },
    {
      "items": [
        {
          "unitPriceCents": 199,
          "quantity": 1
        },
        {
          "unitPriceCents": 199,
          "quantity": 1
        }
      ],
      "expected": 398
    },
    {
      "items": [
        {
          "unitPriceCents": 1,
          "quantity": 1000
        },
        {
          "unitPriceCents": 99999,
          "quantity": 2
        }
      ],
      "expected": 200998
    }
  ],
  "variants": [
    {
      "file": "working.mjs",
      "expected": "pass",
      "reason": "Multiplies every integer price by its quantity and sums the results."
    },
    {
      "file": "quantity-ignored.mjs",
      "expected": "fail",
      "reason": "Ignores quantity: the three-item purchase returns 199 instead of 597."
    },
    {
      "file": "missing.mjs",
      "expected": "not_found",
      "reason": "Exports itemCount only; the total operation does not exist."
    },
    {
      "file": "working-loop.mjs",
      "expected": "pass",
      "reason": "Equivalent loop-based implementation should not trigger a style-dependent false alarm."
    },
    {
      "file": "zero-quantity-default.mjs",
      "expected": "fail",
      "reason": "A zero-quantity line incorrectly defaults to one unit: 199 instead of 0."
    },
    {
      "file": "first-line-only.mjs",
      "expected": "fail",
      "reason": "Drops every line after the first: the multi-line example returns 597 instead of 697."
    },
    {
      "file": "dollars.mjs",
      "expected": "fail",
      "reason": "Converts cents to dollars even though the contract requires cents: 5.97 instead of 597."
    }
  ]
}
