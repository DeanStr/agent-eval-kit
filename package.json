{
  "name": "agent-eval-kit",
  "version": "0.3.0",
  "description": "Provider-neutral project evaluation harness powered by Codex, Claude Code, or Grok Build subscriptions.",
  "type": "module",
  "bin": {
    "aek": "dist/cli.js",
    "aek-browser-mcp": "dist/browser/mcp.js",
    "aek-workspace-mcp": "dist/workspace/mcp.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write --error-on-warnings .",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke:browser": "tsx scripts/browser-smoke.ts",
    "smoke:browser:full": "tsx scripts/browser-regression.ts",
    "smoke:package": "tsx scripts/package-smoke.ts",
    "smoke:provider": "tsx scripts/reference-eval.ts --smoke",
    "test:reference": "tsx scripts/reference-eval.ts",
    "install:browser": "playwright install chromium",
    "aek": "tsx src/cli.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright": "1.62.1",
    "sharp": "0.35.4",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
