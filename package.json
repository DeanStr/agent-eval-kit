{
  "name": "agent-eval-kit",
  "version": "0.7.0",
  "description": "Provider-neutral project evaluation harness powered by Codex, Claude Code, Grok Build, or Cursor subscriptions.",
  "type": "module",
  "bin": {
    "aek": "dist/cli.js",
    "aek-browser-mcp": "dist/browser/mcp.js",
    "aek-workspace-mcp": "dist/workspace/mcp.js"
  },
  "exports": {
    "./benchmark/experiment": {
      "types": "./dist/benchmark-experiment.d.ts",
      "default": "./dist/benchmark-experiment.js"
    },
    "./benchmark": {
      "types": "./dist/benchmark.d.ts",
      "default": "./dist/benchmark.js"
    },
    "./email": {
      "types": "./dist/email/mailbox.d.ts",
      "default": "./dist/email/mailbox.js"
    },
    "./evidence/files": {
      "types": "./dist/evidence/files.d.ts",
      "default": "./dist/evidence/files.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "README.md",
    "examples/first-run/*.mjs",
    "examples/first-run/*.yaml",
    "examples/first-run/specs/*.yaml",
    "examples/text-datasets/*.yaml",
    "examples/text-datasets/*.json",
    "examples/text-datasets/*.md",
    "examples/text-datasets/specs/*.yaml",
    "examples/authoring/*.mjs",
    "examples/authoring/*.yaml",
    "examples/authoring/*.json",
    "examples/authoring/*.md",
    "examples/authoring/specs/*.yaml",
    "examples/visual/*.mjs",
    "examples/visual/*.yaml",
    "examples/visual/*.html",
    "examples/visual/*.svg",
    "examples/visual/*.md",
    "examples/visual/specs/*.yaml",
    "examples/skill-comparison/**/*.mjs",
    "examples/skill-comparison/**/*.md",
    "examples/skill-comparison/*.json",
    "examples/skill-comparison/*.yaml",
    "examples/benchmark/*.mjs",
    "examples/benchmark/*.json",
    "examples/benchmark/*.md",
    "examples/judge-validation/pilot.mjs",
    "examples/judge-validation/pilot-collect.mjs",
    "examples/judge-validation/results-pilot-2026-10-21.json",
    "examples/judge-validation/run.mjs",
    "examples/judge-validation/README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write --error-on-warnings .",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --import tsx --test test/*.test.ts",
    "smoke:browser": "tsx scripts/browser-smoke.ts",
    "smoke:browser:full": "tsx scripts/browser-regression.ts",
    "smoke:package": "tsx scripts/package-smoke.ts",
    "smoke:provider": "tsx scripts/reference-eval.ts --smoke",
    "test:reference": "tsx scripts/reference-eval.ts",
    "judge:validate": "tsx scripts/judge-validation.ts",
    "install:browser": "playwright install chromium",
    "aek": "tsx src/cli.ts",
    "prepack": "pnpm build",
    "package:release": "tsx scripts/package-release.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "parse5": "^8.0.1",
    "playwright": "1.62.1",
    "sharp": "0.35.5",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
